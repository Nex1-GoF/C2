<Window x:Class="C2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:C2"
        xmlns:views="clr-namespace:C2.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- 행: 위 3/4, 아래 1/4 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- 열: 왼쪽 3/4, 오른쪽 1/4 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- MapPanel: 왼쪽 위 (3/4, 3/4) -->
        <views:MapPanel Grid.Row="0" Grid.Column="0" 
                        Margin="5" Background="LightBlue"/>

        <!-- MissilePanel: 왼쪽 아래 (3/4, 1/4) -->
        <views:MissilePanel Grid.Row="1" Grid.Column="0" 
                           Margin="5" Background="LightGray"/>

        <!-- TargetPanel: 오른쪽 위 (1/4, 3/4) -->
        <views:TargetPanel Grid.Row="0" Grid.Column="1" 
                            Margin="5" Background="LightGray"/>

        <!-- LogPanel: 오른쪽 아래 (1/4, 1/4) -->
        <views:LogPanel Grid.Row="1" Grid.Column="1" 
                        Margin="5" Background="LightCoral"/>
    </Grid>
</Window>
