<UserControl x:Class="C2.Views.Markers.MissileMarker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="60">

    <Border BorderBrush="ForestGreen"
            BorderThickness="1.5"
            CornerRadius="2"
            Background="Transparent"
            Padding="6"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 🔹 왼쪽 삼각형 + 화살표 -->
            <Grid Grid.Column="0"
                  RenderTransformOrigin="0.5,0.5"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <!-- ✅ Yaw 각도 회전 (0:북, 90:동) -->
                    <RotateTransform Angle="{Binding Yaw}" />
                </Grid.RenderTransform>

                <!-- 삼각형 (기체) -->
                <Polygon Points="0,0 14,28 -14,28"
                         Stroke="ForestGreen"
                         StrokeThickness="1.5"
                         Fill="Transparent"/>

                <!-- 화살표 (Yaw 방향) -->
                <Line X1="0" Y1="10" X2="0" Y2="-14"
                      Stroke="ForestGreen"
                      StrokeThickness="2"
                      StrokeEndLineCap="Triangle" />
            </Grid>

            <!-- 🔸 오른쪽 텍스트 정보 -->
            <StackPanel Grid.Column="1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Id}"
                           Foreground="ForestGreen"
                           FontWeight="Bold"
                           FontSize="12"/>

                <TextBlock Text="{Binding Altitude, StringFormat='고도 : {0:F1}'}"
                           Foreground="ForestGreen"
                           FontSize="11"
                           Margin="0,2,0,0"/>

                <TextBlock Text="{Binding TargetId, StringFormat='표적 : {0}'}"
                           Foreground="ForestGreen"
                           FontSize="11"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
