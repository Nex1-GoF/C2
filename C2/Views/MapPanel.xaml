<UserControl x:Class="C2.Views.MapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:markers="clr-namespace:C2.Views.Markers"
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation">


    <!-- 🧩 리소스: ViewModel별 템플릿 -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:MissileMarkerViewModel}">
            <markers:MissileMarker />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TargetMarkerViewModel}">
            <markers:TargetMarker />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PIPMarkerViewModel}">
            <markers:PIPMarker />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- 🗺️ 지도 -->
        <gmap:GMapControl x:Name="PART_Map"/>

        <!-- 🟩 미사일 마커 -->
        <ItemsControl ItemsSource="{Binding MissileMarkers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- 🟨 표적 마커 -->
        <ItemsControl ItemsSource="{Binding TargetMarkers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- 🟥 PIP 마커 -->
        <ItemsControl ItemsSource="{Binding PIPMarkers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
