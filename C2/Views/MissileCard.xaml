<UserControl x:Class="C2.Views.MissileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:converters="clr-namespace:C2.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MissileCardViewModel}">

    <UserControl.Resources>
        <!-- ✅ Converter 등록 -->
        <converters:MissileStateToBrushConverter x:Key="MissileStateToBrushConverter"/>
        <converters:MissileStateToStringConverter x:Key="MissileStateToStringConverter"/>
        <converters:MissileStateToVisibilityConverter x:Key="MissileStateToVisibilityConverter"/>

        <!-- ✅ DropShadowEffect -->
        <DropShadowEffect x:Key="DropShadowEffect"
                          Color="Black"
                          BlurRadius="10"
                          ShadowDepth="3"
                          Opacity="0.5"/>
    </UserControl.Resources>

    <Border Background="#0D1B2A"
            CornerRadius="10"
            Padding="12"
            Margin="6"
            BorderBrush="#1E2A3A"
            BorderThickness="1"
            Width="260"
            Height="190"
            SnapsToDevicePixels="True"
            Effect="{StaticResource DropShadowEffect}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 상단: 상태 아이콘 + 유도탄명 + 상태명 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12"
                         Fill="{Binding State, Converter={StaticResource MissileStateToBrushConverter}}"
                         Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Id}"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="14"/>
                <TextBlock Text="{Binding State, Converter={StaticResource MissileStateToStringConverter}}"
                           Foreground="White"
                           FontSize="14"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 중앙: 주요 정보 (왼쪽/오른쪽 2열 구조) -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 🟦 왼쪽 정보 -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">

                    <!-- 표적 -->
                    <TextBlock Text="{Binding TargetId, StringFormat=표적: {0}}"
                               Foreground="LightGray"
                               FontSize="12">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="target">
                                <Binding Path="State"/>
                                <Binding Path="TargetId"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- 위도 -->
                    <TextBlock Text="{Binding Latitude, StringFormat=위도: {0:F3}°}"
                               Foreground="LightGray"
                               FontSize="12">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                                <Binding Path="State"/>
                                <Binding Path="TargetId"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- 경도 -->
                    <TextBlock Text="{Binding Longitude, StringFormat=경도: {0:F3}°}"
                               Foreground="LightGray"
                               FontSize="12">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                                <Binding Path="State"/>
                                <Binding Path="TargetId"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- 고도 -->
                    <TextBlock Text="{Binding Altitude, StringFormat=고도: {0} m}"
                               Foreground="LightGray"
                               FontSize="12">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                                <Binding Path="State"/>
                                <Binding Path="TargetId"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </StackPanel>

                <!-- 🟩 오른쪽 정보 -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <!-- 요 -->
                    <TextBlock Text="{Binding Yaw, StringFormat=요: {0:F1}°}"
                               Foreground="LightGray"
                               FontSize="12">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                                <Binding Path="State"/>
                                <Binding Path="TargetId"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- 피치 -->
                    <TextBlock Text="{Binding Pitch, StringFormat=피치: {0:F1}°}"
                               Foreground="LightGray"
                               FontSize="12">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                                <Binding Path="State"/>
                                <Binding Path="TargetId"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>

                    <!-- 비행시간 -->
                    <TextBlock Text="{Binding FlightTime, StringFormat=비행시간: {0} ms}"
                               Foreground="LightGray"
                               FontSize="12">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                                <Binding Path="State"/>
                                <Binding Path="TargetId"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- 하단: 비상 폭파 버튼 -->
            <Button Grid.Row="2"
                    Content="비상 폭파"
                    Background="DarkRed"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="0,10,0,0"
                    Height="28"
                    Command="{Binding EmergencyCommand}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="emergency">
                        <Binding Path="State"/>
                        <Binding Path="TargetId"/>
                    </MultiBinding>
                </Button.Visibility>
            </Button>
        </Grid>
    </Border>
</UserControl>
