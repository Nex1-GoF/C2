<Application x:Class="C2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:C2"
             xmlns:converters ="clr-namespace:C2.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <converters:MissileStateToVisibilityConverter x:Key="MissileStateToVisibilityConverter" />
            <converters:MissileStateToBrushConverter x:Key="MissileStateToBrushConverter" />
            <converters:MissileStateToStringConverter x:Key="MissileStateToStringConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
