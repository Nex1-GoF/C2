<Window x:Class="C2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:C2.Views"
        xmlns:local="clr-namespace:C2"
        xmlns:vm="clr-namespace:C2.ViewModels"
        mc:Ignorable="d"
        Title="C2 Command Center"
        Height="1080" Width="1920">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <views:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
        <local:CollapseIconConverter x:Key="CollapseIconConverter"/>
        <Geometry x:Key="IconExpand">M 0 0 L 10 10 L 20 0 Z</Geometry>
        <Geometry x:Key="IconCollapse">M 0 10 L 10 0 L 20 10 Z</Geometry>
        <!-- 위 화살표 -->
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 지도 + 유도탄 -->
        <Grid x:Name="LeftGrid" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="7.5*"/>
                <RowDefinition Height="2.5*"/>
            </Grid.RowDefinitions>

            <!-- 지도 -->
            <views:MapPanel x:Name="MapPanelRef" Grid.Row="0" Background="LightBlue"/>
            <StackPanel Orientation="Vertical"
            Grid.Row="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="0">
                <!--접기/펼치기-->
                <Button Width="30" Height="30"
        Background="#303030"
        BorderThickness="0"
        Click="GlobalCollapseButton_Click">

                    <Path Stretch="Uniform"
          Fill="White"
          Data="{Binding ElementName=MissilePanelRef,
                 Path=DataContext.IsCollapsed,
                 Converter={StaticResource CollapseIconConverter}}"/>
                </Button>
            </StackPanel>
            <!-- 오른쪽 아래: 발사 UI -->
            <StackPanel Orientation="Vertical"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="10">

                <!-- 발사 진행 바 -->
                <ProgressBar Height="8"
                             Width="170"
                             Margin="0,0,0,5"
                             Value="{Binding LaunchProgress}"
                             Maximum="100">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProgressBarVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- 버튼 그룹 -->
                <StackPanel Orientation="Horizontal">
                    <!-- 발사 버튼 -->
                    <Button Width="80"
                        Margin="0,0,5,0"
                        Content="{Binding IsLaunching, Converter={StaticResource BoolToTextConverter}, ConverterParameter='발사|발사취소'}"
                        Command="{Binding LaunchOrAbortCommand}"
                        IsEnabled="{Binding CanLaunchOrAbort}"/>


                    <!-- 교전할당 버튼 -->
                    <Button Content="교전할당"
                            Width="80"
                            Margin="5,0,0,0"
                            Command="{Binding AssignTargetCommand}"
                            IsEnabled="{Binding CanAssign}"/>
                </StackPanel>
            </StackPanel>

            <!-- 유도탄 패널 -->
            <views:MissilePanel Grid.Row="1"
                                Background="LightGreen"
                                x:Name="MissilePanelRef"/>
        </Grid>

        <!-- 오른쪽: 표적 + 로그 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="7.5*"/>
                <RowDefinition Height="2.5*"/>
            </Grid.RowDefinitions>

            <!-- 표적 패널 -->
            <views:TargetPanel Grid.Row="0" Background="#0A1B2A"/>

            <!-- 로그 패널 -->
            <views:LogPanel Grid.Row="1" Background="LightGray"/>
        </Grid>
    </Grid>
</Window>
