<Window x:Class="C2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:C2.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1200">

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 지도 + 유도탄 -->
        <Grid x:Name="LeftGrid" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <views:MapPanel x:Name="MapPanelRef" Grid.Row="0" Background="LightBlue"/>
            <views:MissilePanel x:Name="MissilePanelRef" Grid.Row="1" Background="LightGreen"/>
        </Grid>

        <!-- 오른쪽: 표적 + 로그 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <views:TargetPanel Grid.Row="0" Background="LightCoral"/>
            <views:LogPanel Grid.Row="1" Background="LightGray"/>
        </Grid>
    </Grid>
</Window>