<Window x:Class="C2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:C2.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1200">

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 지도 + 유도탄 -->
        <Grid x:Name="LeftGrid" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- 지도 -->
            <views:MapPanel x:Name="MapPanelRef" Grid.Row="0" Background="LightBlue"/>

            <!-- ✅ 오른쪽 아래: 발사 UI -->
            <StackPanel Orientation="Vertical"
                        Grid.Row="0" Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="10">

                <!-- ✅ 발사 진행 바 -->
                <ProgressBar Height="8"
                             Width="170"
                             Margin="0,0,0,5"
                             Value="{Binding LaunchProgress}"
                             Maximum="100">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProgressBarVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- ✅ 버튼 그룹 -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="발사"
                            Width="80"
                            Margin="0,0,5,0"
                            Command="{Binding LaunchCommand}"
                            IsEnabled="{Binding CanLaunch}"/>

                    <Button Content="교전할당"
                            Width="80"
                            Margin="5,0,0,0"
                            Command="{Binding AssignTargetCommand}"
                            IsEnabled="{Binding CanAssign}"/>
                </StackPanel>
            </StackPanel>

            <!-- 유도탄 패널 -->
            <views:MissilePanel Grid.Row="1" Grid.Column="0"
                                Background="LightGreen" x:Name="MissilePanelRef"/>
        </Grid>

        <!-- 오른쪽: 표적 + 로그 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- 표적 패널 -->
            <views:TargetPanel Grid.Row="0" Background="LightCoral"/>

            <!-- 로그 패널 -->
            <views:LogPanel Grid.Row="1" Background="LightGray"/>
        </Grid>
    </Grid>
</Window>
