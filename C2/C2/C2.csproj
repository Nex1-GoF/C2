<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Fonts\JetBrainsMono-Bold.ttf" />
    <None Remove="Resources\Fonts\JetBrainsMono-Medium.ttf" />
    <None Remove="Resources\Fonts\NanumSquareNeo-aLt.ttf" />
    <None Remove="Resources\Fonts\NanumSquareNeo-bRg.ttf" />
    <None Remove="Resources\Fonts\NanumSquareNeo-cBd.ttf" />
    <None Remove="Resources\Fonts\NanumSquareNeo-dEb.ttf" />
    <None Remove="Resources\Fonts\NanumSquareNeo-eHv.ttf" />
    <None Remove="Resources\Fonts\Octapost.ttf" />
    <None Remove="Resources\manual.pdf" />
    <None Remove="Resources\msl_marker.png" />
    <None Remove="Resources\target.png" />
    <None Remove="Resources\target2.png" />
    <None Remove="Resources\target3.jpg" />
    <None Remove="Resources\target4.jpg" />
    <None Remove="Resources\target5.png" />
    <None Remove="Resources\target6.png" />
    <None Remove="Resources\target7.png" />
    <None Remove="Resources\tgt_marker.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="GMap.NET.Core" Version="2.1.7" />
    <PackageReference Include="GMap.NET.WinPresentation" Version="2.1.7" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Driver\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\JetBrainsMono-Bold.ttf" />
    <Resource Include="Resources\Fonts\JetBrainsMono-Medium.ttf" />
    <Resource Include="Resources\Fonts\NanumSquareNeo-aLt.ttf" />
    <Resource Include="Resources\Fonts\NanumSquareNeo-bRg.ttf" />
    <Resource Include="Resources\Fonts\NanumSquareNeo-cBd.ttf" />
    <Resource Include="Resources\Fonts\NanumSquareNeo-dEb.ttf" />
    <Resource Include="Resources\Fonts\NanumSquareNeo-eHv.ttf" />
    <Resource Include="Resources\Fonts\Octapost.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\manual.pdf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\msl_marker.png" />
    <Resource Include="Resources\target.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\target2.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\target3.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\target4.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\target5.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\target6.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\target7.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\tgt_marker.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\network.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
