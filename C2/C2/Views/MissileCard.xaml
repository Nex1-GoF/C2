<UserControl x:Class="C2.Views.MissileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:converters="clr-namespace:C2.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MissileCardViewModel}">

    <UserControl.Resources>
        <!-- ✅ Converter 등록 -->
        <converters:MissileStateToBrushConverter x:Key="MissileStateToBrushConverter"/>
        <converters:MissileStateToStringConverter x:Key="MissileStateToStringConverter"/>
        <converters:MissileStateToVisibilityConverter x:Key="MissileStateToVisibilityConverter"/>

        <!-- ✅ DropShadowEffect 리소스 등록 -->
        <DropShadowEffect x:Key="DropShadowEffect"
                          Color="Black"
                          BlurRadius="10"
                          ShadowDepth="3"
                          Opacity="0.5"/>
    </UserControl.Resources>

    <Border Background="#0D1B2A"
            CornerRadius="10"
            Padding="12"
            Margin="6"
            BorderBrush="#1E2A3A"
            BorderThickness="1"
            Width="250"
            Height="175"
            SnapsToDevicePixels="True"
            Effect="{StaticResource DropShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 상단: 상태 아이콘 + 유도탄명 + 상태명 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12"
                         Fill="{Binding State, Converter={StaticResource MissileStateToBrushConverter}}"
                         Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Id}"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="14"/>
                <TextBlock Text="{Binding State, Converter={StaticResource MissileStateToStringConverter}}"
                           Foreground="White"
                           FontSize="14"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 중간: 주요 정보 -->
            <StackPanel Grid.Row="1" Margin="0,6,0,0">

                <!-- 표적 표시 -->
                <TextBlock Text="{Binding TargetId, StringFormat=표적: {0}}"
                           Foreground="LightGray"
                           FontSize="12">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="target">
                            <Binding Path="State"/>
                            <Binding Path="TargetId"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>

                <!-- 위도 -->
                <TextBlock Text="{Binding Latitude, StringFormat=위도: {0:F3}}"
                           Foreground="LightGray"
                           FontSize="12">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                            <Binding Path="State"/>
                            <Binding Path="TargetId"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>

                <!-- 경도 -->
                <TextBlock Text="{Binding Longitude, StringFormat=경도: {0:F3}}"
                           Foreground="LightGray"
                           FontSize="12">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                            <Binding Path="State"/>
                            <Binding Path="TargetId"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>

                <!-- 속도 -->
                <TextBlock Text="{Binding Speed, StringFormat=속도: {0} m/s}"
                           Foreground="LightGray"
                           FontSize="12">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="midterm">
                            <Binding Path="State"/>
                            <Binding Path="TargetId"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>

            <!-- 하단: 비상 폭파 버튼 -->
            <Button Grid.Row="2"
                    Content="비상 폭파"
                    Background="DarkRed"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="0,10,0,0"
                    Height="28">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource MissileStateToVisibilityConverter}" ConverterParameter="emergency">
                        <Binding Path="State"/>
                        <Binding Path="TargetId"/>
                    </MultiBinding>
                </Button.Visibility>
            </Button>
            <!-- Command="{Binding EmergencyCommand}"-->
        </Grid>
    </Border>
</UserControl>
