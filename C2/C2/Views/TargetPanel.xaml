<UserControl x:Class="C2.Views.TargetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models"
             xmlns:local="clr-namespace:C2.Views"
             Background="#0A1922">

    <UserControl.Resources>
        <local:TargetStateToBrushConverter x:Key="TargetStateToBrushConverter"/>
        <vm:SelectedTargetBorderThicknessConverter x:Key="SelectedTargetBorderThicknessConverter"/>
    </UserControl.Resources>

    <!-- 전체 패널: 상단 고정 제목 + 스크롤 영역 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 제목 -->
            <RowDefinition Height="*"/>
            <!-- 스크롤 영역 -->
        </Grid.RowDefinitions>

        <!-- ===================== 상단 제목 ===================== -->
        <TextBlock Text="TARGETS"
                   Style="{StaticResource HudHeaderTextStyle}"
                   Margin="4,0,0,12"/>

        <!-- ===================== 스크롤 가능한 카드 영역 ===================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- 4개 카드를 세로로 배치하는 Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ItemsControl -->
                <ItemsControl ItemsSource="{Binding Targets}">
                    <!-- 카드 템플릿 -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Target}">

                            <Border CornerRadius="10"
                                Background="{StaticResource HudBgPanelBrush}"
                                BorderBrush="{StaticResource HudAccentDimBrush}"
                                Margin="10"
                                Padding="14"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown" 
                                >

                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource SelectedTargetBorderThicknessConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.SelectedTarget"
                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>


                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ================= LEFT ================= -->
                                    <Grid Grid.Column="0" Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- 상태/ID -->
                                            <RowDefinition Height="*"/>
                                            <!-- 본문 -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 탐지시간 -->
                                        </Grid.RowDefinitions>

                                        <!-- 상단: 상태 + ID -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14"
                                                 Fill="{Binding State, Converter={StaticResource TargetStateToBrushConverter}}"
                                                 Margin="0,0,6,4"/>

                                            <TextBlock Text="{Binding Id}" Margin="0,0,8,0"
                                                   Style="{StaticResource HudSmallHeaderTextStyle}"
                                                   Foreground="{Binding State, Converter={StaticResource TargetStateToBrushConverter}}" />

                                            <TextBlock Text="{Binding State}"
                                                   Style="{StaticResource HudSmallHeaderTextStyle}"
                                                   Foreground="{Binding State, Converter={StaticResource TargetStateToBrushConverter}}"/>
                                        </StackPanel>

                                        <!-- 중간 내용 -->
                                        <StackPanel Grid.Row="1" Orientation="Vertical">
                                            <TextBlock Text="{Binding CurLatDisplay, StringFormat='위도: {0}'}"
                                                Style="{StaticResource HudInfoTextStyle}"/>

                                            <TextBlock Text="{Binding CurLonDisplay, StringFormat='경도: {0}'}"
                                                Style="{StaticResource HudInfoTextStyle}"/>

                                            <TextBlock Text="{Binding YawRaw, StringFormat='방향: {0}°'}"
                                                Style="{StaticResource HudInfoTextStyle}"/>

                                            <TextBlock Text="{Binding Speed, StringFormat='속도: {0} m/s'}"
                                                Style="{StaticResource HudInfoTextStyle}"/>

                                            <TextBlock Text="{Binding Altitude, StringFormat='고도: {0} m'}"
                                                Style="{StaticResource HudInfoTextStyle}"/>
                                        </StackPanel>

                                        <!-- 탐지 시간 -->
                                        <TextBlock Grid.Row="2"
                                           Text="{Binding DetectTime, StringFormat='탐지시간: HH:mm:ss'}"
                                           Style="{StaticResource HudTimestampTextStyle}"
                                           Margin="0,10,0,0"/>
                                    </Grid>


                                    <!-- ================= RIGHT ================= -->
                                    <Grid Grid.Column="1" Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <!-- 이미지 -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 버튼 -->
                                        </Grid.RowDefinitions>

                                        <!-- 이미지 -->
                                        <Image Grid.Row="0"
                                           x:Name="TargetImage"
                                           Source="/Resources/target2.png"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                        <!-- 교전할당 버튼 -->
                                        <Button Grid.Row="1"
                                            Content="교전할당"
                                            Width="{Binding ActualWidth, ElementName=TargetImage}"
                                            Height="32"
                                            Background="#174556"
                                            BorderBrush="#45E8E1"
                                            Foreground="#AEE8F3"
                                            BorderThickness="1.2"
                                            Padding="4"
                                            FontSize="13"
                                            HorizontalAlignment="Center"
                                            PreviewMouseLeftButtonDown="EngagementButton_Click"
                                            Command="{Binding DataContext.EngagementCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>
