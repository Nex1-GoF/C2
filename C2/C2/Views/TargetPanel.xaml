<UserControl x:Class="C2.Views.TargetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models"
             xmlns:local="clr-namespace:C2.Views"
             Background="#0A1B2A">

    <!-- 데이터 바인딩 -->
    <UserControl.DataContext>
        <vm:TargetViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- 상태별 색상 브러시 변환기 -->
        <local:TargetStateToBrushConverter x:Key="TargetStateToBrushConverter" />
    </UserControl.Resources>

    <Grid Margin="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Targets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Target}">
                        <Grid Width="220" Height="130" Margin="6"
                              Background="#1E2A3A">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 상단: ID + 상태 -->
                            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                                <Ellipse Width="14" Height="14"
                                         Fill="{Binding State, Converter={StaticResource TargetStateToBrushConverter}}"
                                         Stroke="Black" StrokeThickness="1"
                                         Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Id}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"/>
                                <TextBlock Text=" | " Foreground="Gray"/>
                                <TextBlock Text="{Binding State}"
                                           Foreground="{Binding State, Converter={StaticResource TargetStateToBrushConverter}}"
                                           FontSize="13" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- 중간: 주요 정보 -->
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CurLocDisplay}"
                                           Foreground="LightGray" FontSize="12"/>
                                <TextBlock Text="{Binding EndLocDisplay}"
                                           Foreground="LightSlateGray" FontSize="12"/>
                                <TextBlock Text="{Binding CurYawDisplay}"
                                           Foreground="LightBlue" FontSize="12"/>
                                <TextBlock Text="{Binding Speed, StringFormat='속도: {0} m/s'}"
                                           Foreground="LightGray" FontSize="12"/>
                                <TextBlock Text="{Binding Altitude, StringFormat='고도: {0} m'}"
                                           Foreground="LightGray" FontSize="12"/>
                            </StackPanel>

                            <!-- 하단: 탐지시각 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DetectTime, StringFormat='HH:mm:ss'}"
                                           Foreground="DarkGray" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
