<UserControl x:Class="C2.Views.TargetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models"
             xmlns:local="clr-namespace:C2.Views"
             Background="{StaticResource TargetPanelBrush}">

    <UserControl.Resources>
        <local:TargetStateToBrushConverter x:Key="TargetStateToBrushConverter"/>
        <local:TargetFocusedToBackgroundConverter x:Key="TargetFocusedToBackgroundConverter"/>
    </UserControl.Resources>

    <!-- 전체 패널: 상단 고정 제목 + 스크롤 영역 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 제목 -->
            <RowDefinition Height="*"/>
            <!-- 스크롤 영역 -->
        </Grid.RowDefinitions>

        <!-- ===================== 상단 제목 ===================== -->
        <TextBlock Text="TARGETS"
                   Style="{StaticResource TargetPanelHeaderTextStyle}"
                   Margin="4,12,0,12"/>

        <!-- ===================== 스크롤 가능한 카드 영역 ===================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- 4개 카드를 세로로 배치하는 Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ItemsControl -->
                <ItemsControl ItemsSource="{Binding Targets}">
                    <!-- 카드 템플릿 -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Target}">

                            <Border CornerRadius="8"
                                Background="{StaticResource TargetCardBrush}"
                                Padding="6"
                                Margin="6"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown">

                                <!-- 선택 강조 -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- 상태 + ID -->
                                    <Border Padding="6"
                                        BorderBrush="{StaticResource TargetCardStrokeBrush}"
                                        CornerRadius="6,6,0,0"
                                        BorderThickness="4,4,4,2">
                                        
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource TargetFocusedToBackgroundConverter}">
                                                <!-- 현재 카드 -->
                                                <Binding />

                                                <!-- ViewModel의 SelectedTarget -->
                                                <Binding Path="DataContext.SelectedTarget"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Border.Background>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            
                                            <TextBlock Text="{Binding Id, StringFormat='TGT-00{0}'}"
                                               Style="{StaticResource TargetCardIdTextStyle}"
                                               VerticalAlignment="Center"
                                               Grid.Column="0"/>
                                            <Border Grid.Column="1"/>
                                            <TextBlock Text="{Binding State}" Grid.Column="2"
                                               Style="{StaticResource TargetCardIdTextStyle}"
                                               Margin="6,0,0,0"/>
                                        </Grid>


                                    </Border>
                                    <Border 
                                        Background="{StaticResource TargetCardBrush}"
                                        BorderBrush="{StaticResource TargetCardStrokeBrush}"
                                        CornerRadius="0,0,6,6"
                                        BorderThickness="4,2,4,4"
                                        Padding="6"
                                        Grid.Row="1">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ✦ LEFT SECTION -->
                                            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Left">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="AUTO"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Vertical" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding CurLatDisplay, StringFormat='위도: {0}'}"
                                                        Style="{StaticResource TargetContentTextStyle}"/>

                                                    <TextBlock Text="{Binding CurLonDisplay, StringFormat='경도: {0}'}"
                                                        Style="{StaticResource TargetContentTextStyle}"/>

                                                    <TextBlock Text="{Binding YawRaw, StringFormat='방향: {0}°'}"
                                                        Style="{StaticResource TargetContentTextStyle}"/>

                                                    <TextBlock Text="{Binding Speed, StringFormat='속도: {0} m/s'}"
                                                        Style="{StaticResource TargetContentTextStyle}"/>

                                                    <TextBlock Text="{Binding Altitude, StringFormat='고도: {0} m'}"
                                                        Style="{StaticResource TargetContentTextStyle}"/>
                                                </StackPanel>

                                                <!-- 탐지 시간 -->
                                                <TextBlock Text="{Binding DetectTime, StringFormat='탐지시간: HH:mm:ss'}" Grid.Row="1" VerticalAlignment="Bottom"
                                                    Style="{StaticResource TargetTimeStampTextStyle}"/>
                                            </Grid>

                                            <!-- ✦ RIGHT SECTION -->
                                            <Grid Grid.Column="1" >
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 🔵 이미지: 상단 고정 + 좌우 스트래치 -->
                                                <Image Grid.Row="0"
                                                   x:Name="TargetImage"
                                                   Source="/Resources/target2.png"
                                                   Stretch="Uniform"
                                                   Height="90"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,0,10"/>

                                                <!-- 🔵 버튼: 하단 고정 + 너비 이미지와 동일 -->
                                                <Button Grid.Row="2"
                                                    Content="교전할당"
                                                    Padding="10,10"
                                                    Command="{Binding DataContext.EngagementCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AbortButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Bottom"
                                                    PreviewMouseLeftButtonDown="EngagementButton_Click"
                                                    Width="{Binding ActualWidth, ElementName=TargetImage}"/>
                                            </Grid>

                                        </Grid>
                                    </Border>

                                </Grid>


                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>
