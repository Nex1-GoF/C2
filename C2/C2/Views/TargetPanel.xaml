<UserControl x:Class="C2.Views.TargetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models"
             xmlns:local="clr-namespace:C2.Views"
             Background="#0A1B2A">

    <UserControl.DataContext>
        <vm:TargetViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <local:TargetStateToBrushConverter x:Key="TargetStateToBrushConverter"/>
        <vm:IsSelectedTargetConverter x:Key="IsSelectedTargetConverter"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Targets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- ✅ 여기서 컨테이너 스타일에 트리거 설정 -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource IsSelectedTargetConverter}">
                                        <!-- 현재 카드 Target 객체 -->
                                        <Binding Path="." />
                                        <!-- ViewModel의 SelectedTarget -->
                                        <Binding Path="DataContext.SelectedTarget"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00C8FF" BlurRadius="15" ShadowDepth="0" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Border BorderBrush="#00C8FF"
                                                    BorderThickness="2.5"
                                                    CornerRadius="8"
                                                    Background="#1E2A3A"
                                                    Padding="8" Margin="6">
                                                <ContentPresenter Content="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <!-- ✅ 각 표적 카드 템플릿 -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Target}">
                        <Border Width="220" Height="130" Margin="6" Padding="8"
                                Background="#1E2A3A"
                                BorderBrush="#2E3C4F"
                                BorderThickness="1"
                                CornerRadius="8"
                                MouseDown="TargetCard_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 상단 -->
                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{Binding State, Converter={StaticResource TargetStateToBrushConverter}}"
                                             Stroke="Black" StrokeThickness="1"
                                             Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Id}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text=" | " Foreground="Gray"/>
                                    <TextBlock Text="{Binding State}" 
                                               Foreground="{Binding State, Converter={StaticResource TargetStateToBrushConverter}}"
                                               FontWeight="Bold" FontSize="13"/>
                                </StackPanel>

                                <!-- 중단 정보 -->
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding CurLocDisplay}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding EndLocDisplay}" Foreground="LightSlateGray" FontSize="12"/>
                                    <TextBlock Text="{Binding CurYawDisplay}" Foreground="LightBlue" FontSize="12"/>
                                    <TextBlock Text="{Binding Speed, StringFormat='속도: {0} m/s'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding Altitude, StringFormat='고도: {0} m'}" Foreground="LightGray" FontSize="12"/>
                                </StackPanel>

                                <!-- 하단 -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DetectTime, StringFormat='HH:mm:ss'}"
                                               Foreground="DarkGray" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>