<UserControl x:Class="C2.Views.TargetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models"
             xmlns:local="clr-namespace:C2.Views"
             Background="{StaticResource TargetPanelBrush}">

    <UserControl.Resources>
        <local:TargetStateToBrushConverter x:Key="TargetStateToBrushConverter"/>
        <local:TargetFocusedToBackgroundConverter x:Key="TargetFocusedToBackgroundConverter"/>
    </UserControl.Resources>

    <!-- 전체 패널: 상단 고정 제목 + 스크롤 영역 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 제목 -->
            <RowDefinition Height="*"/>
            <!-- 스크롤 영역 -->
        </Grid.RowDefinitions>

        <!-- ===================== 상단 제목 ===================== -->
        <TextBlock Text="TARGETS"
                   Style="{StaticResource TargetPanelHeaderTextStyle}"
                   Margin="4,12,0,12"/>

        <!-- ===================== 스크롤 가능한 카드 영역 ===================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- 4개 카드를 세로로 배치하는 Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ItemsControl -->
                <ItemsControl ItemsSource="{Binding Targets}">
                    <!-- 카드 템플릿 -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Target}">

                            <Border CornerRadius="8"
                                Background="{StaticResource TargetCardBrush}"
                                Padding="6"
                                Margin="6"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown">

                                <!-- 선택 강조 -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- 상태 + ID -->
                                    <Border Padding="6"
                                        BorderBrush="{StaticResource TargetCardStrokeBrush}"
                                        CornerRadius="6,6,0,0"
                                        BorderThickness="4,4,4,2">
                                        
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource TargetFocusedToBackgroundConverter}">
                                                <!-- 현재 카드 -->
                                                <Binding />

                                                <!-- ViewModel의 SelectedTarget -->
                                                <Binding Path="DataContext.SelectedTarget"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Border.Background>

                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            
                                            <TextBlock Text="{Binding Id, StringFormat='TGT-00{0}'}"
                                               Style="{StaticResource TargetCardIdTextStyle}"
                                               VerticalAlignment="Center" Margin="0,0,0,8"
                                               Grid.Column="0"/>
                                            <Border Grid.Column="1"/>
                                            <TextBlock Text="{Binding TargetInfoName}" Grid.Column="2"
                                               Style="{StaticResource TargetCardFlightIdTextStyle}"
                                               VerticalAlignment="Bottom"/>
                                        </Grid>


                                    </Border>
                                    <Border 
                                        Background="{StaticResource TargetCardBrush}"
                                        BorderBrush="{StaticResource TargetCardStrokeBrush}"
                                        CornerRadius="0,0,6,6"
                                        BorderThickness="4,2,4,4"
                                        Padding="8"
                                        Grid.Row="1">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Vertical" Grid.Row="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border 
                                                            Background="{StaticResource TargetCardContentBlockBrush}"
                                                            CornerRadius="4"
                                                            Padding="2"
                                                            Margin="0,0,4,2"
                                                            Grid.Column="0">
                                                                <TextBlock 
                                                                Text="위도"
                                                                Style="{StaticResource TargetContentTextStyle}"/>
                                                            </Border>
                                                            <Border 
                                                                Background="{StaticResource TargetCardContentBlockBrush}"
                                                                CornerRadius="4"
                                                                Padding="2"
                                                                Margin="2,0,4,2"
                                                                Grid.Column="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Text="{Binding CurLatDisplay}"
                                                                        Style="{StaticResource TargetContentTextStyle}"
                                                                        Grid.Column="0"
                                                                        />
                                                                    <TextBlock
                                                                        Text="(°)"
                                                                        Style="{StaticResource TargetContentTextStyle}"
                                                                        Grid.Column="1"/>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                        <Grid Grid.Column="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border 
                                                            Background="{StaticResource TargetCardContentBlockBrush}"
                                                            CornerRadius="4"
                                                            Padding="2"
                                                            Margin="0,0,4,2"
                                                            Grid.Column="0">
                                                                <TextBlock 
                                                                Text="경도"
                                                                Style="{StaticResource TargetContentTextStyle}"/>
                                                            </Border>
                                                            <Border 
                                                            Background="{StaticResource TargetCardContentBlockBrush}"
                                                            CornerRadius="4"
                                                            Padding="2"
                                                            Margin="0,0,4,2"
                                                            Grid.Column="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Text="{Binding CurLonDisplay}"
                                                                        Style="{StaticResource TargetContentTextStyle}"
                                                                        Grid.Column="0"
                                                                        />

                                                                    <TextBlock
                                                                Text="(°)"
                                                                Style="{StaticResource TargetContentTextStyle}"
                                                                Grid.Column="1"/>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                        
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border 
                                                        Background="{StaticResource TargetCardContentBlockBrush}"
                                                        CornerRadius="4"
                                                        Padding="2"
                                                        Margin="0,2,4,2"
                                                        Grid.Column="0">
                                                            <TextBlock 
                                                            Text="고도"
                                                            Style="{StaticResource TargetContentTextStyle}"/>
                                                        </Border>
                                                        <Border 
                                                        Background="{StaticResource TargetCardContentBlockBrush}"
                                                        CornerRadius="4"
                                                        Padding="2"
                                                        Margin="4,2"
                                                        Grid.Column="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Text="{Binding Altitude}"
                                                                    Style="{StaticResource TargetContentTextStyle}"
                                                                    Grid.Column="0"/>

                                                                <TextBlock
                                                                    Text="(m)"
                                                                    Style="{StaticResource TargetContentTextStyle}"
                                                                    Grid.Column="1"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border 
                                                        Background="{StaticResource TargetCardContentBlockBrush}"
                                                        CornerRadius="4"
                                                        Padding="2"
                                                        Margin="0,2,4,2"
                                                        Grid.Column="0">
                                                            <TextBlock 
                                                            Text="속력"
                                                            Style="{StaticResource TargetContentTextStyle}"/>
                                                        </Border>
                                                        <Border 
                                                            Background="{StaticResource TargetCardContentBlockBrush}"
                                                            CornerRadius="4"
                                                            Padding="2"
                                                            Margin="4,2,4,2"
                                                            Grid.Column="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                    Text="{Binding Speed}"
                                                                    Style="{StaticResource TargetContentTextStyle}"
                                                                    Grid.Column="0"/>

                                                                <TextBlock
                                                                    Text="(m/s)"
                                                                    Style="{StaticResource TargetContentTextStyle}"
                                                                    Grid.Column="1">
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border 
                                                        Background="{StaticResource TargetCardContentBlockBrush}"
                                                        CornerRadius="4"
                                                        Padding="2"
                                                        Margin="0,2,4,0"
                                                        Grid.Column="0">
                                                            <TextBlock 
                                                            Text="헤딩"
                                                            Style="{StaticResource TargetContentTextStyle}"/>
                                                        </Border>
                                                        <Border 
                                                            Background="{StaticResource TargetCardContentBlockBrush}"
                                                            CornerRadius="4"
                                                            Padding="2"
                                                            Margin="4,2,4,0"
                                                            Grid.Column="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                    Text="{Binding CurYawDisplay}"
                                                                    Style="{StaticResource TargetContentTextStyle}"
                                                                    Grid.Column="0"/>

                                                                <TextBlock
                                                                    Text="(°)"
                                                                    Style="{StaticResource TargetContentTextStyle}"
                                                                    Grid.Column="1">
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                                <!-- 🔵 이미지: 상단 고정 + 좌우 스트래치 -->
                                                <Image Grid.Column="1"
                                                   x:Name="TargetImage"
                                                   Source= '{Binding TargetInfoImagePath}'
                                                   Stretch="Uniform"
                                                   Height="90"
                                                   HorizontalAlignment="Stretch" 
                                                   VerticalAlignment="Top"
                                                   Margin="8,0,0,0"/>
                                            </Grid>
                                        
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock 
                                                    Text="{Binding DetectTime, StringFormat='탐지시간: HH:mm:ss'}" Grid.Column="0"
                                                    Style="{StaticResource TargetTimeStampTextStyle}"
                                                    VerticalAlignment="Bottom"/>
                                                <Button Grid.Column="2"
                                                    Content="교전할당"
                                                    Padding="10,10"
                                                    Command="{Binding DataContext.EngagementCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AbortButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Bottom"
                                                    PreviewMouseLeftButtonDown="EngagementButton_Click"
                                                    Width="{Binding ActualWidth, ElementName=TargetImage}"/>
                                            </Grid>
                                        </Grid>
                                        
                                    </Border>

                                </Grid>


                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>
