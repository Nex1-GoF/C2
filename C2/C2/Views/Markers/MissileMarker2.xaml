<UserControl x:Class="C2.Views.Markers.MissileMarker2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- ① 회전되는 미사일 픽토그램 영역 -->
        <Grid Width="40" Height="40"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform x:Name="Rt"/>
            </Grid.RenderTransform>

            <Rectangle x:Name="MissileRect"
                       Width="40" Height="40"
                       Fill="Green">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="pack://application:,,,/C2;component/Resources/msl_marker.png"/>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>

        <!-- ② 회전되지 않는 텍스트 영역 -->
        <TextBlock x:Name="IdLabel"
                   Text="MSL-000"
                   Foreground="Green"
                   Style="{StaticResource MarkerTextStyle}"
                   VerticalAlignment="Center"
                   Margin="50,0,0,0" />
        <!-- 픽토그램 오른쪽에 붙음 -->

    </Grid>
</UserControl>
