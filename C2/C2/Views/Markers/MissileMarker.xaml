<UserControl x:Class="C2.Views.Markers.MissileMarker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="40">

    <UserControl.Resources>
        <!-- bool → Visibility 변환기 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- 전체 컨트롤의 표시 여부를 바인딩 -->
    <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 🔹 삼각형 (Yaw 각도에 따라 회전) -->
        <Grid Grid.Column="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <!-- 0도 = 북쪽, 90도 = 동쪽 -->
                <RotateTransform Angle="{Binding Yaw1}" />
            </Grid.RenderTransform>

            <!-- 삼각형 -->
            <Polygon 
                    Points="0,-15 12,10 -12,10"
                    Fill="{Binding FillBrush}"
                    Stroke="{Binding StrokeBrush}"
                    StrokeThickness="1.5"/>
        </Grid>

        <!-- 🔸 Missile ID -->
        <TextBlock Grid.Column="1"
                   Text="{Binding Id}"
                   Foreground="{Binding StrokeBrush}"
                   FontSize="13"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Margin="5,0,0,0"/>
    </Grid>
</UserControl>
