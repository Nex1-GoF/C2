<UserControl x:Class="C2.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models">

    <!-- ViewModel 바인딩 -->
    <UserControl.DataContext>
        <vm:LogViewModel/>
    </UserControl.DataContext>

    <Border Background="#132235" Padding="10">

        <ScrollViewer x:Name="LogScroll"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="ScrollViewer_ScrollChanged">

            <ItemsControl ItemsSource="{Binding DisplayLogs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Log}">

                        <Grid Margin="2,2,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 타임스탬프 -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DateTime, StringFormat='[HH:mm:ss] '}"
                                       Style="{StaticResource HudLogTimestampTextStyle}"
                                       VerticalAlignment="Top"
                                       Margin="0,0,4,0"/>

                            <!-- 로그 메시지 -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Message}"
                                       Style="{StaticResource LogTextStyle}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"/>
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>
    </Border>
</UserControl>
