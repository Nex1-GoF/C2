<UserControl x:Class="C2.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models">

    <UserControl.DataContext>
        <vm:LogViewModel/>
    </UserControl.DataContext>

    <Border Background="#132235" Padding="10" CornerRadius="6">
        <!-- ✅ ScrollViewer에 반드시 x:Name 추가 -->
        <ScrollViewer x:Name="LogScroll"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="ScrollViewer_ScrollChanged">

            <ItemsControl ItemsSource="{Binding DisplayLogs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Log}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding DateTime, StringFormat='[HH:mm:ss] '}"
                                       Foreground="LightGray"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding Foreground}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>
    </Border>
</UserControl>
