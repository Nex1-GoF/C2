<UserControl x:Class="C2.Views.MissilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models"
             xmlns:local="clr-namespace:C2.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="1600"
             Background="{StaticResource MissilePanelBrush}">

    <!-- ViewModel 연결 -->
    <UserControl.DataContext>
        <vm:MissileViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <local:FocusedToBackgroundConverter x:Key="FocusedToBackgroundConverter"/>
        <local:StateToColorConverter x:Key="StateToColorConverter"/>
        <local:StateToTextConverter x:Key="StateToTextConverter"/>
        <local:StateToEnabledConverter x:Key="StateToEnabledConverter"/>
        <local:CoordinateStateMultiConverter x:Key="CoordinateStateMultiConverter"/>
        <local:CollapseIconConverter x:Key="CollapseIconConverter"/>

        <!-- ============================== -->
        <!-- 🔶 Expanded 카드 -->
        <!-- ============================== -->
        <DataTemplate x:Key="ExpandedCardTemplate">
            <Border Background="{StaticResource MissilePanelBrush}"
                    Margin="6"
                    MouseLeftButtonDown="MissileCard_MouseLeftButtonDown"
                    Height="Auto">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="6,6,6,3"
                            BorderBrush="{StaticResource TargetCardStrokeBrush}"
                            CornerRadius="6,6,0,0"
                            BorderThickness="4,4,4,2"
                            >
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource FocusedToBackgroundConverter}">
                                <!-- current missile -->
                                <Binding Path="." />

                                <!-- selected missiles list -->
                                <Binding Path="DataContext.SelectedMissiles"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Border.Background>
                        <Grid Margin="6" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 왼쪽 상태 블록 -->
                            <Border 
                                Background="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                CornerRadius="8"
                                Padding="10,4"
                                Grid.Column="0">
                                <TextBlock 
                                    Text="{Binding State, Converter={StaticResource StateToTextConverter}}"
                                    Style="{StaticResource MissileCardStateTextStyle}"/>
                            </Border>

                            <!-- 오른쪽 MSL 번호 -->
                            <TextBlock 
                                Text="{Binding IdNumber, StringFormat='MSL-{0:000}'}"
                                Style="{StaticResource MissileCardIdTextStyle}"
                                VerticalAlignment="Center"
                                Grid.Column="2"/>
                        </Grid>

                    </Border>
                    <Border 
                        Background="{StaticResource MissilePanelBrush}"
                        BorderBrush="{StaticResource TargetCardStrokeBrush}"
                        CornerRadius="0,0,6,6"
                        BorderThickness="4,2,4,4"
                        Margin="0"
                        Grid.Row="1">
                        <StackPanel Orientation="Vertical" Margin="6" Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border VerticalAlignment="Center"
                                    Background="{StaticResource MissileCardContentBlockBrush}"
                                    CornerRadius="4"
                                    Padding="2"
                                    Margin="4,2"
                                    Grid.Column="0">
                                        <TextBlock 
                                        Text="위도"
                                        Style="{StaticResource MissileContentTextStyle}"/>
                                    </Border>
                                    <Border 
                                        Background="{StaticResource MissileCardContentBlockBrush}"
                                        CornerRadius="4"
                                        Padding="2"
                                        Margin="4,2"
                                        Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                            Style="{StaticResource MissileContentTextStyle}"
                                            Grid.Column="0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource CoordinateStateMultiConverter}"
                                                        >
                                                        <Binding Path="Latitude"/>
                                                        <Binding Path="State"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock
                                            Text="(°)"
                                            Style="{StaticResource MissileContentTextStyle}"
                                            Grid.Column="1"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border 
                                    Background="{StaticResource MissileCardContentBlockBrush}"
                                    CornerRadius="4"
                                    Padding="2"
                                    Margin="4,2"
                                    Grid.Column="0">
                                        <TextBlock 
                                        Text="경도"
                                        Style="{StaticResource MissileContentTextStyle}"/>
                                    </Border>
                                    <Border 
                                    Background="{StaticResource MissileCardContentBlockBrush}"
                                    CornerRadius="4"
                                    Padding="2"
                                    Margin="4,2"
                                    Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                            Style="{StaticResource MissileContentTextStyle}"
                                            Grid.Column="0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource CoordinateStateMultiConverter}"
                                                                  >
                                                        <Binding Path="Longitude"/>
                                                        <Binding Path="State"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock
                                        Text="(°)"
                                        Style="{StaticResource MissileContentTextStyle}"
                                        Grid.Column="1"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border 
                                Background="{StaticResource MissileCardContentBlockBrush}"
                                CornerRadius="4"
                                Padding="2"
                                Margin="4,2"
                                Grid.Column="0">
                                    <TextBlock 
                                    Text="고도"
                                    Style="{StaticResource MissileContentTextStyle}"/>
                                </Border>
                                <Border 
                                Background="{StaticResource MissileCardContentBlockBrush}"
                                CornerRadius="4"
                                Padding="2"
                                Margin="4,2"
                                Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                        Style="{StaticResource MissileContentTextStyle}"
                                        Grid.Column="0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource CoordinateStateMultiConverter}">
                                                    <Binding Path="Altitude"/>
                                                    <Binding Path="State"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock
                                        Text="(m)"
                                        Style="{StaticResource MissileContentTextStyle}"
                                        Grid.Column="1"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border 
                                    Background="{StaticResource MissileCardContentBlockBrush}"
                                    CornerRadius="4"
                                    Padding="2"
                                    Margin="4,2"
                                    Grid.Column="0">
                                    <TextBlock 
                                        Text="속도"
                                        Style="{StaticResource MissileContentTextStyle}"/>
                                </Border>
                                <Border 
                                Background="{StaticResource MissileCardContentBlockBrush}"
                                CornerRadius="4"
                                Padding="2"
                                Margin="4,2"
                                Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                        Style="{StaticResource MissileContentTextStyle}"
                                        Grid.Column="0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource CoordinateStateMultiConverter}">
                                                    <Binding Path="Speed"/>
                                                    <Binding Path="State"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock
                                        Text="(m/s)"
                                        Style="{StaticResource MissileContentTextStyle}"
                                        Grid.Column="1">
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border 
                                    Background="{StaticResource MissileCardContentBlockBrush}"
                                    CornerRadius="4"
                                    Padding="2"
                                    Margin="4,2"
                                    Grid.Column="0">
                                    <TextBlock 
                                        Text="거리"
                                        Style="{StaticResource MissileContentTextStyle}"/>
                                </Border>
                                <Border 
                                Background="{StaticResource MissileCardContentBlockBrush}"
                                CornerRadius="4"
                                Padding="2"
                                Margin="4,2"
                                Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                        Style="{StaticResource MissileContentTextStyle}"
                                        Grid.Column="0"
                                        Text="{Binding DisplayRemainingDistance}">
                                        
                                        </TextBlock>
                                        <TextBlock
                                        Text="(m)"
                                        Style="{StaticResource MissileContentTextStyle}"
                                        Grid.Column="1">
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- 왼쪽: 최대 확장 -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 오른쪽: 버튼 크기만큼 -->
                                </Grid.ColumnDefinitions>

                                <!-- 왼쪽 텍스트 -->
                                <TextBlock 
                                Text="{Binding TargetDisplayId, StringFormat='목표 타겟 ID: {0}'}"
                                Style="{StaticResource MissileTargetIDTextStyle}"
                                VerticalAlignment="Bottom"
                                Grid.Column="0"/>

                                <!-- 오른쪽 버튼 -->
                                <Button Content="비상폭파"
                                PreviewMouseLeftButtonDown="AbortButton_Click"
                                Command="{Binding DataContext.AbortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding State, Converter={StaticResource StateToEnabledConverter}}"
                                Style="{StaticResource AbortButtonStyle}"
                                Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============================== -->
        <!-- 🔶 Compact 카드 (HUD 스타일) -->
        <!-- ============================== -->
        <DataTemplate x:Key="CompactCardTemplate">
            <Border 
                Background="{StaticResource MissilePanelBrush}"
                Margin="6"
                MouseLeftButtonDown="MissileCard_MouseLeftButtonDown">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border 
                        BorderBrush="{StaticResource TargetCardStrokeBrush}"
                        CornerRadius="6,6,0,0"
                        BorderThickness="4,4,4,0"
                        Margin="0"
                        Grid.Row="0">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource FocusedToBackgroundConverter}">
                                <!-- current missile -->
                                <Binding Path="." />

                                <!-- selected missiles list -->
                                <Binding Path="DataContext.SelectedMissiles"
                                    RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Border.Background>
                        <Grid Margin="6" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 왼쪽 상태 블록 -->
                            <Border 
                                Background="{Binding State, Converter={StaticResource StateToColorConverter}}"
                                CornerRadius="20"
                                Padding="10,4"
                                Grid.Column="0">
                                <TextBlock 
                                    Text="{Binding State, Converter={StaticResource StateToTextConverter}}"
                                    Style="{StaticResource MissileCardStateTextStyle}"/>
                            </Border>

                            <!-- 오른쪽 MSL 번호 -->
                            <TextBlock 
                                Text="{Binding IdNumber, StringFormat='MSL-{0:000}'}"
                                Style="{StaticResource MissileCardIdTextStyle}"
                                VerticalAlignment="Center"
                                Grid.Column="2"/>
                        </Grid>
                    </Border>
                    <Border 
                        Background="{StaticResource MissilePanelBrush}"
                        BorderBrush="{StaticResource TargetCardStrokeBrush}"
                        CornerRadius="0,0,6,6"
                        BorderThickness="4,0,4,4"
                        Margin="0"
                        Grid.Row="1">

                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- 왼쪽: 최대 확장 -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- 오른쪽: 버튼 크기만큼 -->
                            </Grid.ColumnDefinitions>

                            <!-- 왼쪽 텍스트 -->
                            <TextBlock 
                            Text="{Binding TargetDisplayId, StringFormat='목표 타겟 ID: {0}'}"
                            Style="{StaticResource MissileTargetIDTextStyle}"
                            VerticalAlignment="Bottom"
                            Grid.Column="0"/>

                            <!-- 오른쪽 버튼 -->
                            <Button Content="비상폭파"
                            PreviewMouseLeftButtonDown="AbortButton_Click"
                            Command="{Binding DataContext.AbortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding State, Converter={StaticResource StateToEnabledConverter}}"
                            Style="{StaticResource AbortButtonStyle}"
                            Grid.Column="1"/>
                        </Grid>
                    </Border>
                </Grid>



            </Border>
        </DataTemplate>

        <!-- 템플릿 선택자 -->
        <local:MissileTemplateSelector x:Key="MissileTemplateSelector"
                                       ExpandedTemplate="{StaticResource ExpandedCardTemplate}"
                                       CompactTemplate="{StaticResource CompactCardTemplate}"/>

    </UserControl.Resources>


    <!-- ============================== -->
    <!-- 🔶 전체 레이아웃 (HUD 배경 적용) -->
    <!-- ============================== -->
    <Grid Background="{StaticResource MissilePanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 헤더 -->
            <RowDefinition Height="*"/>
            <!-- 미사일 리스트 -->
        </Grid.RowDefinitions>

        <!-- ⭐ 헤더 부분 -->
        <StackPanel Orientation="Horizontal"
                Grid.Row="0"
                Background="{StaticResource MissilePanelBrush}"
                Margin="0">

            <Border BorderThickness="0"
                Background="{StaticResource HudBgDarkBrush}"
                Padding="4"
                CornerRadius="4">
                <Button Width="30"
                    Height="30"
                    BorderThickness="0"
                    Background="{StaticResource PenalDownButtonBackgroundBrush}"
                    Click="LocalCollapseButton_Click">
                    <Path Stretch="Uniform"
                      Fill="{StaticResource PenalDownButtonBrush}"
                      Data="{Binding DataContext.IsCollapsed,
                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource CollapseIconConverter}}"/>
                </Button>
            </Border>

            <TextBlock Text="MISSILES"
                   Margin="8,0,0,0"
                   Style="{StaticResource MissilePanelHeaderTextStyle}"
                   VerticalAlignment="Center" />
        </StackPanel>


        <!-- ⭐ 미사일 카드 리스트 -->
        <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="MissileItemsControl"
                      ItemsSource="{Binding Missiles}"
                      ItemTemplateSelector="{StaticResource MissileTemplateSelector}"
                      HorizontalContentAlignment="Stretch">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>

    </Grid>

</UserControl>
