<UserControl x:Class="C2.Views.MissilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:C2.ViewModels"
             xmlns:models="clr-namespace:C2.Models"
             xmlns:local="clr-namespace:C2.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="1600">

    <!-- ViewModel 연결 -->
    <UserControl.DataContext>
        <vm:MissileViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- 변환기 -->
        <local:StateToTextConverter x:Key="StateToTextConverter"/>
        <local:StateToColorConverter x:Key="StateToColorConverter"/>
        <local:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
        <local:StateToEnabledConverter x:Key="StateToEnabledConverter"/>

        <!-- 공용 버튼 스타일 -->
        <Style x:Key="AbortButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Red"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Background" Value="Red"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 카드 템플릿: Width 고정 제거, Stretch + MinWidth만 -->
        <DataTemplate x:Key="ExpandedCardTemplate">
            <Border Background="#1E2A3A"
                    Margin="3,6,3,6"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    MinWidth="160">
                <Grid>
                    <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="30" Height="30"
             Fill="{Binding State, Converter={StaticResource StateToColorConverter}}"
             Stroke="Black" StrokeThickness="1"
             HorizontalAlignment="Center" />
                            <TextBlock Text="L-SAM"
                Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}"
               FontWeight="Bold"
               FontSize="25"
               Margin="4,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding State, Converter={StaticResource StateToTextConverter}}"
           Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}" FontSize="20" Margin="20,0,0,0"/>
                        <TextBlock Text="{Binding TargetId, StringFormat='표적: {0}'}" Foreground="Red" FontSize="16" Margin="10,20,0,0"/>
                        
                        <TextBlock Text="{Binding State, Converter={StaticResource StateToTextConverter}, StringFormat='상태: {0}'}"
Foreground="LightGray" FontSize="16"  Margin="10,0,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">

                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding IdNumber, StringFormat='LSAM-{0:000}'}"
            Foreground="LightGray"
           FontWeight="Bold"
           FontSize="20"
           Margin="4,10,0,20" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Latitude, StringFormat='위도: {0}°'}" Foreground="LightGray" FontSize="16"/>
                        <TextBlock Text="{Binding Longitude, StringFormat='경도: {0}° '}" Foreground="LightGray" FontSize="16"/>
                        <TextBlock Text="{Binding Altitude, StringFormat='고도: {0} m'}" Foreground="LightGray" FontSize="16"/>
                        <TextBlock Text="{Binding Speed, StringFormat='속력: {0} m/s'}" Foreground="LightGray" FontSize="16"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Content="비상폭파" 
            Command="{Binding DataContext.AbortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            IsEnabled="{Binding State, Converter={StaticResource StateToEnabledConverter}}"
            Width="80" Height="30" Margin="0,0,0,0"
            Style="{StaticResource AbortButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompactCardTemplate">
            <Border Background="#1A2535"
                    Margin="3,6,3,6"
                    Padding="8"
                    HorizontalAlignment="Stretch"
                    BorderBrush="#2E3C4F"
                    BorderThickness="1"
                    MinWidth="160">
                <StackPanel Orientation="Vertical">
                    <!-- 상태 아이콘/ID -->
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                        <Ellipse Width="20" Height="20"
Fill="{Binding State, Converter={StaticResource StateToColorConverter}}"
Stroke="Black" StrokeThickness="1" VerticalAlignment="Center"
/>
                        <TextBlock Text="L-SAM"
 Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}"
FontWeight="Bold"
FontSize="20" VerticalAlignment="Top"
Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding State, Converter={StaticResource StateToTextConverter}}"
Foreground="{Binding State, Converter={StaticResource StateToColorConverter}}" FontSize="15" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Id}"
 Foreground="LightGray"
FontWeight="Bold"
FontSize="15"
Margin="0,0,10,0" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="{Binding TargetId, StringFormat='표적: {0}'}" Foreground="Red" FontSize="16" Margin="10,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                            <Button Content="비상폭파" 
Command="{Binding DataContext.AbortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
CommandParameter="{Binding}"
IsEnabled="{Binding State, Converter={StaticResource StateToEnabledConverter}}"
Width="100" Height="20" Margin="0,0,0,0"
Style="{StaticResource AbortButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                   

                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 템플릿 선택자 -->
        <local:MissileTemplateSelector x:Key="MissileTemplateSelector"
                                       ExpandedTemplate="{StaticResource ExpandedCardTemplate}"
                                       CompactTemplate="{StaticResource CompactCardTemplate}"/>
    </UserControl.Resources>

    <!-- 레이아웃 -->
    <Grid Background="#0A1B2A">
        <ScrollViewer VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="MissileItemsControl"
                          ItemsSource="{Binding Missiles}"
                          ItemTemplateSelector="{StaticResource MissileTemplateSelector}"
                          HorizontalContentAlignment="Stretch">
                <!-- 셀 폭을 꽉 채우게 -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- ✅ 4열 고정 -->
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- 각 셀 여백/정렬 -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>